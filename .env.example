# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=

# Where callback requests are delivered (defaults to musicglenview@gmail.com)
CONTACT_TO_EMAIL=musicglenview@gmail.com

# Sender address. Use onboarding@resend.dev for testing; use your verified domain in production.
CONTACT_FROM_EMAIL=Family Music Academy <onboarding@resend.dev>

# Public site URL for social previews and metadata (production domain)
NEXT_PUBLIC_SITE_URL=https://www.thefamilymusicacademy.com

# Gallery admin (/admin) — generate secret: openssl rand -base64 32
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Vercel Blob — create in Vercel project → Storage → Blob
BLOB_READ_WRITE_TOKEN=

# Blob store access: "private" (default on new stores) or "public"
# Private stores serve gallery files via /api/gallery/media
BLOB_STORE_ACCESS=private
